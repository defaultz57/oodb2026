-- Create object type for department location
CREATE TYPE locty AS OBJECT(
building_no INTEGER,
city_name VARCHAR(20),
pincode NUMBER(6));
/

-- Create object type for department manager
CREATE TYPE dept_mgty AS OBJECT(
mgr_name VARCHAR(30),
mgr_phone NUMBER(10));
/

-- Create department table with foreign key to emp
CREATE TABLE dept(
dept_id NUMBER(5) PRIMARY KEY,
dept_code VARCHAR(10),
dept_name VARCHAR(20),
manager dept_mgty,
total_emp INTEGER,
location locty,
emp_id INTEGER,
FOREIGN KEY (emp_id) REFERENCES emp(emp_id));

