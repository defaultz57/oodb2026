-- Display all employees
SELECT * FROM emp;

-- Display all departments
SELECT * FROM dept;

-- Employee name and city from address object
SELECT e.emp_name, e.address.city_name
FROM emp e;

-- Employee name and skill name
SELECT e.emp_name, e.skill.skill_name
FROM emp e;

-- Employee name with department name (join)
SELECT e.emp_name, d.dept_name FROM emp e JOIN dept d ON e.emp_id = d.emp_id;

-- Employee name with department manager name
SELECT e.emp_name, d.manager.mgr_name FROM emp e
JOIN dept d ON e.emp_id = d.emp_id;

-- Employee name, skill and department location city
SELECT e.emp_name, e.skill.skill_name, d.location.city_name FROM emp e JOIN dept d ON e.emp_id = d.emp_id;

-- Employee name, city and department code
SELECT e.emp_name, e.address.city_name, d.dept_code FROM emp e
JOIN dept d ON e.emp_id = d.emp_id;

-- First name, skill and department of employee John
SELECT e.emp_name.first_name, e.skill.skill_name, d.dept_name
FROM emp e JOIN dept d ON e.emp_id = d.emp_id WHERE
e.emp_name.first_name = 'John';

-- Employees with experience above 2.0 years and salary above 30000
SELECT e.emp_name, e.salary, e.skill.skill_name FROM emp e
WHERE e.skill.exp_year > 2.0 AND e.salary > 30000;

-- Update salary and experience of employee 2
Update emp e SET e.salary = 70000, e.skill.exp_year = 5.0 WHERE e.emp_id = 2;

-- Delete department 60
DELETE FROM dept WHERE dept_id = 60;

-- Remove the total_emp column from dept
ALTER TABLE dept DROP COLUMN total_emp;
