-- Create object type for address
CREATE TYPE addressTy AS OBJECT(
building_no INTEGER,
building_name VARCHAR(20),
area_name VARCHAR(20),
city_name VARCHAR(20),
pincode NUMBER(6));
/

-- Create object type for employee name
CREATE TYPE ename AS OBJECT(
surname VARCHAR(20),
first_name VARCHAR(20),
middle_name VARCHAR(20));
/

-- Create object type for skill
CREATE TYPE skillty AS OBJECT(
skill_name VARCHAR(30),
prof_level VARCHAR(20),
exp_year NUMBER(3,1));
/

-- Create employee table using object types
CREATE TABLE emp(
emp_id INTEGER PRIMARY KEY,
emp_name ename,
dob DATE,
address addressTy,
skill skillty,
salary NUMBER(5),
dept_id NUMBER(5));

