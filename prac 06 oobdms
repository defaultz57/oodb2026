-- Create object type for person name
CREATE TYPE personTy AS OBJECT(
surname VARCHAR(10),
first_name VARCHAR(20),
middle_name VARCHAR(20),
mother_name VARCHAR(20));
/

-- Create object type for address
CREATE TYPE addressTy AS OBJECT(
block_no Number(3),
building_name VARCHAR(20),
road_name VARCHAR(20),
area_name VARCHAR(20),
city_name VARCHAR(20));
/

-- Create object type for date
CREATE TYPE dateTy AS OBJECT(
date_no NUMBER(3),
month VARCHAR(10),
year NUMBER(5));
/

-- Create table using the object types as columns
CREATE TABLE person(
name personTy,
dob dateTy,
address addressTy,
Salary NUMBER(10),
designation VARCHAR(20),
organization VARCHAR(20));

