-- Display all records
Select * from person;

-- Salary of person whose first name is B
SELECT Salary FROM person a
WHERE a.name.first_name = 'B';

-- Persons born in year 2001 or 2003
SELECT * FROM person a
WHERE a.dob.year = 2001
OR a.dob.year = 2003;

-- Average, minimum, maximum salary of persons born in 2002 or 2006
SELECT AVG(a.salary), MIN(a.salary), MAX(a.salary) FROM person a WHERE a.dob.year IN (2002, 2006);

-- Increase salary by 500 for person with surname A
UPDATE person a SET a.salary = a.salary + 500
WHERE a.name.surname = 'A';

-- Designation and salary of person born in July whose mother name is D
SELECT p.designation, p.salary FROM person p
WHERE p.dob.month = 'July' AND p.name.mother_name = 'D';

-- Persons whose first name starts with N
SELECT * FROM person p WHERE p.name.first_name LIKE 'N%';

-- Name, designation, organization of persons born before 1990
SELECT a.name.surname, a.name.first_name, a.designation, a.organization FROM person a
WHERE a.dob.year < 1990;

-- Persons born between 1980 and 2004
SELECT a.name.first_name, a.dob.year, a.salary, a.organization FROM person a
WHERE a.dob.year >= 1980 AND a.dob.year <= 2004;

-- Delete persons born in or before 1980
DELETE FROM person p
WHERE p.dob.year <= 1980;

-- Remove the road_name attribute from address type
